rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /services/{serviceId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /site/{documentId} {
      allow read: if documentId == 'settings';
      allow create, update, delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['name','service','details','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.service is string && request.resource.data.service.size() <= 100
        && request.resource.data.details is string && request.resource.data.details.size() <= 1200;
      allow read, update, delete: if isAdmin();
    }
  }
}
